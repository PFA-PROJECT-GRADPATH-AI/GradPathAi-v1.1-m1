{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/backend/GradPath.Member1.Api/GradPath.Member1.Api.csproj"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch-backend",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/backend/GradPath.Member1.Api/GradPath.Member1.Api.csproj"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "isBackground": true
    }
  ]
}
