{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Backend API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/GradPath.Member1.Api/bin/Debug/net9.0/GradPath.Member1.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/GradPath.Member1.Api",
      "stopAtEntry": false,
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Frontend (Vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    }
  ]
}
